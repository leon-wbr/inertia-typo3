includes:
  - example/vendor/saschaegerer/phpstan-typo3/extension.neon

parameters:
  level: 8
  paths:
    - Classes
    - Configuration
    - Tests
    - ext_localconf.php
    # The example's sitepackage
    - example/packages/sitepackage/Classes
    # The conformance harness's case extension
    - conformance/packages/conformance/Classes
    - conformance/packages/conformance/Configuration
  tmpDir: example/var/cache/phpstan
  typo3:
    requestGetAttributeMapping:
      inertia: LeonWbr\Inertia\Service\InertiaService
