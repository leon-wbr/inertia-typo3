includes:
  - example/vendor/saschaegerer/phpstan-typo3/extension.neon

parameters:
  level: 8
  paths:
    - Classes
    - Configuration
    - Tests
    - ext_localconf.php
    # The example's sitepackage, as installed from leon-wbr/inertia-sitepackage
    - example/vendor/leon-wbr/inertia-sitepackage/Classes
  tmpDir: example/var/cache/phpstan
  typo3:
    requestGetAttributeMapping:
      inertia: LeonWbr\Inertia\Service\InertiaService
