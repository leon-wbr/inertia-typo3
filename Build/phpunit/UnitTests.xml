<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../example/vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="true"
         bootstrap="UnitTestsBootstrap.php"
         recordTestRunHistory="false"
         colors="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <testsuites>
        <testsuite name="Unit tests">
            <directory>../../Tests/Unit/</directory>
        </testsuite>
    </testsuites>
    <!--
        Coverage needs a driver (pcov in the DDEV image) and the report as a
        CLI option: `composer test:coverage` in example/. A <coverage><report>
        here would warn, and so fail the suite, on a PHP without a driver.
    -->
    <source>
        <include>
            <directory>../../Classes</directory>
        </include>
        <exclude>
            <!-- Test helpers for sitepackages, exercised by the functional suite -->
            <directory>../../Classes/Testing</directory>
        </exclude>
    </source>
    <php>
        <ini name="display_errors" value="1"/>
        <env name="TYPO3_CONTEXT" value="Testing"/>
    </php>
</phpunit>
