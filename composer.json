{
  "name": "leon-wbr/inertia",
  "type": "typo3-cms-extension",
  "description": "A TYPO3 adapter for Inertia.js.",
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^14.3.10",
    "typo3/cms-extbase": "^14.3.10",
    "typo3/cms-fluid": "^14.3.10",
    "typo3/cms-frontend": "^14.3.10"
  },
  "autoload": {
    "psr-4": {
      "LeonWbr\\Inertia\\": "Classes/"
    }
  },
  "authors": [
    {
      "name": "Leon Weber",
      "email": "lw.leonweber@gmail.com"
    }
  ],
  "extra": {
    "typo3/cms": {
      "extension-key": "inertia"
    }
  }
}
