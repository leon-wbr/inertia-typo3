page = PAGE
page {
    typeNum = 0
    config {
        noPageTitle = 2
    }

    # The page plugin is uncached (USER_INT): the page itself stays in TYPO3's
    # page cache, the Inertia page object is built per request.
    10 = EXTBASEPLUGIN
    10 {
        extensionName = Inertia
        pluginName = Renderer
    }
}

plugin.tx_inertia {
    view {
        templateRootPaths {
            0 = EXT:inertia/Resources/Private/Templates/
        }
    }
}
