{
  "name": "leon-wbr/inertia-example",
  "description": "Runnable TYPO3 project for the Inertia adapter: example site, verification suite and DDEV setup.",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "..",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "packages/*",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.2",
    "leon-wbr/inertia-typo3": "*@dev",
    "leon-wbr/inertia-sitepackage": "@dev",
    "praetorius/vite-asset-collector": "^1.18.4",
    "typo3/cms-backend": "^14.3.10",
    "typo3/cms-core": "^14.3.10",
    "typo3/cms-extbase": "^14.3.10",
    "typo3/cms-fluid": "^14.3.10",
    "typo3/cms-fluid-styled-content": "^14.3.10",
    "typo3/cms-frontend": "^14.3.10",
    "typo3/cms-install": "^14.3.10"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95.27",
    "phpstan/phpstan": "^2.3.4",
    "phpunit/phpunit": "^13.4.6",
    "saschaegerer/phpstan-typo3": "^3.1.0",
    "typo3/testing-framework": "^9.7.0"
  },
  "autoload-dev": {
    "psr-4": {
      "LeonWbr\\Inertia\\Tests\\": "../Tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer check --config=../.php-cs-fixer.dist.php --show-progress=none",
    "cs:fix": "php-cs-fixer fix --config=../.php-cs-fixer.dist.php",
    "stan": "phpstan analyse --configuration=../phpstan.neon --no-progress --memory-limit=1G",
    "test:unit": "phpunit --configuration ../Build/phpunit/UnitTests.xml",
    "test:functional": "phpunit --configuration ../Build/phpunit/FunctionalTests.xml",
    "test": [
      "@test:unit",
      "@test:functional"
    ],
    "test:coverage": [
      "phpunit --configuration ../Build/phpunit/UnitTests.xml --coverage-clover var/coverage/clover.xml --coverage-text=php://stdout --only-summary-for-coverage-text",
      "@php ../Build/Scripts/coverage-check.php var/coverage/clover.xml 74"
    ],
    "check": [
      "@cs",
      "@stan",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "cs": "Checks the PHP code style",
    "cs:fix": "Fixes the PHP code style",
    "stan": "Runs PHPStan",
    "test:unit": "Runs the unit tests",
    "test:functional": "Runs the functional tests",
    "test": "Runs the unit and functional tests",
    "test:coverage": "Runs the unit tests with coverage (needs pcov) and fails below the minimum line coverage",
    "check": "Code style, PHPStan and both test suites: the PHP part of ddev verify"
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "extra": {
    "typo3/cms": {
      "web-dir": "public"
    }
  }
}
